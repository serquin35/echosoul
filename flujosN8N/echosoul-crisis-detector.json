{
  "name": "EchoSoul — crisis-detector",
  "nodes": [
    {
      "id": "09f26a49-2c3a-4ad6-9ac5-53b67388c3a9",
      "name": "Webhook Crisis Check",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        500,
        100
      ],
      "parameters": {
        "path": "crisis-check",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "1383c266-a6c2-4d10-a018-01233d0e956e",
      "name": "Analyze Crisis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $vars.CLAUDE_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({model:'claude-haiku-4-5-20251001',max_tokens:300,messages:[{role:'user',content:`Analiza el siguiente mensaje en busca de señales de crisis emocional o riesgo.\\n\\nClasifica en uno de estos niveles:\\n- none: sin señales de riesgo\\n- low: expresión de tristeza/estrés, sin riesgo inmediato\\n- medium: angustia significativa, posible riesgo, requiere respuesta empática especial\\n- high: mención explícita de autolesión, suicidio u otras crisis graves\\n\\nSi el nivel es medium o high, genera un safeReply apropiado: empático, sin minimizar. Es OBLIGATORIO que incluyas recursos de ayuda reales en tu safeReply, por ejemplo en español: \\\"Línea de atención a la conducta suicida (024)\\\", \\\"Teléfono de la Esperanza (717 003 717)\\\" o \\\"Emergencias (112)\\\".\\n\\nResponde ÚNICAMENTE con JSON válido, sin markdown:\\n{\\\"level\\\": \\\"none|low|medium|high\\\", \\\"safeReply\\\": \\\"string o null\\\"}\\n\\nMensaje a analizar: {{ $json.message }}`}]}) }}",
        "options": {}
      }
    },
    {
      "id": "199e6e24-938f-45ba-a319-6a375fd9c9a8",
      "name": "Parse Crisis Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        500
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst llmText = $input.first().json.content?.[0]?.text ?? '{}';\nlet result = { isCrisis: false, level: 'none', safeReply: null };\n\ntry {\n  const clean = llmText.replace(/```json|```/gi, '').trim();\n  const parsed = JSON.parse(clean);\n  const validLevels = ['none', 'low', 'medium', 'high'];\n  result.level    = validLevels.includes(parsed.level) ? parsed.level : 'none';\n  result.isCrisis = ['medium', 'high'].includes(result.level);\n  result.safeReply = result.isCrisis ? (parsed.safeReply ?? null) : null;\n} catch(e) {\n  // En caso de error de parse, asumimos no-crisis por seguridad de parseo\n  // pero logueamos para revisión\n  console.error('Crisis parse error:', e.message, '| Raw:', llmText.substring(0, 200));\n}\n\nconst webhookData = $('Webhook Crisis Check').first().json;\nreturn [{ json: {\n  user_id:    webhookData.user_id,\n  message:    webhookData.message,\n  isCrisis:   result.isCrisis,\n  level:      result.level,\n  safeReply:  result.safeReply,\n  // Hash del mensaje para almacenamiento (nunca guardamos el texto literal)\n  msg_hash:   btoa(encodeURIComponent(webhookData.user_id + ':' + webhookData.message)).substring(0, 64)\n}}];\n"
      }
    },
    {
      "id": "0c70e3fb-73e8-4833-86c9-5d88f980080b",
      "name": "IF No Crisis",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        500,
        700
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "89cb8874-a146-4fec-a1a5-9eacf7f94bbb",
              "leftValue": "={{ $json.isCrisis }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "false"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "e148baa8-ee80-4c36-8545-49ee230e566f",
      "name": "Respond No Crisis",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        200,
        900
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"isCrisis\":false,\"level\":\"none\",\"safeReply\":null}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "06c194fc-2cf7-4930-a87c-d8acde46f7ce",
      "name": "Log Crisis Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        900
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/crisis_events",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.SUPABASE_SERVICE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({user_id:$json.user_id,level:$json.level,msg_hash:$json.msg_hash}) }}",
        "options": {}
      }
    },
    {
      "id": "9fe79abc-0d52-45a3-b0d1-14e9d9bc2394",
      "name": "IF High Level",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        500,
        1100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "7cbcf522-2153-4249-9132-281ed02197a0",
              "leftValue": "={{ $json.level }}",
              "rightValue": "high",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "4b951dc1-050e-4303-b400-bdc8764428f9",
      "name": "Send Admin Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        200,
