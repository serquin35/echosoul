        }
      }
    },
    {
      "id": "c4854d9c-a05b-46d2-9cef-a36c399367b4",
      "name": "🛡️ Diseño de privacidad",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        860,
        800
      ],
      "parameters": {
        "content": "## Almacenamiento de crisis\nEl mensaje del usuario **nunca** se guarda en `crisis_events`.\n\nSolo se persiste: `user_id`, `level`, `msg_hash` (base64 truncado) y timestamp.\n\nEsto cumple con principio de minimización de datos (GDPR Art. 5).",
        "height": 200,
        "width": 340,
        "color": 6
      }
    }
  ],
