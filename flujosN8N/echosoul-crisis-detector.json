              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({text:`⚠️ EchoSoul Crisis HIGH\\nUser: ${$json.user_id}\\nLevel: ${$json.level}\\nTime: ${new Date().toISOString()}`}) }}",
        "options": {}
      }
    },
    {
      "id": "68cbefaf-3f28-4b64-8267-ebd1086cfc7e",
      "name": "Level Medium (no alert)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
