        "url": "=https://n8n.cheosdesign.info/webhook/crisis-check",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n{\n  \"content\": $('Call OpenAI API').first().json.choices?.[0]?.message?.content ?? '',\n  \"user_id\": $('Webhook Chat').first().json.body.user_id,\n  \"session_id\": $('Webhook Chat').first().json.body.session_id\n}\n}}",
        "options": {}
