    {
      "parameters": {
        "jsCode": "try {\n  const prev = $(\"Call OpenAI API\").first().json;\n  const crisis = $(\"Crisis Check\").first().json;\n  const ctx = $(\"Build System Prompt\").first().json;\n\n  const llmReply = prev.choices?.[0]?.message?.content ?? '';\n  const isCrisis = crisis.isCrisis ?? false;\n  const finalReply = isCrisis && crisis.safeReply ? crisis.safeReply : llmReply;\n\n  return [{\n    json: {\n      user_id: ctx.user_id,\n      session_id: ctx.session_id,\n      message: ctx.message,\n      reply: finalReply,\n      is_crisis: isCrisis,\n      tokens_used: prev.usage?.total_tokens ?? 0\n    }\n  }];\n} catch (error) {\n  throw new Error(`Merge Final Reply failed: ${error.message}`);\n}"
      },
