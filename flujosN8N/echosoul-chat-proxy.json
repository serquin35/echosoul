        "options": {},
        "rawContentType": "application/json",
        "sendBody": true,
        "url": "https://n8n.cheosdesign.info/webhook/crisis-check"
      },
      "id": "e5573c11-f6e7-44d4-8d15-80bdbc27a227",
      "name": "Crisis Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1168, 608],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Call OpenAI API').first().json;\nconst crisis = $('Crisis Check').first().json;\nconst ctx = $('Build System Prompt').first().json;\n\nconst llmReply = prev.choices?.[0]?.message?.content ?? '';\nconst isCrisis = crisis.isCrisis ?? false;\nconst finalReply = isCrisis && crisis.safeReply ? crisis.safeReply : llmReply;\n\nreturn [{\n  json: {\n    user_id: ctx.user_id,\n    session_id: ctx.session_id,\n    message: ctx.message,\n    reply: finalReply,\n    is_crisis: isCrisis,\n    tokens_used: prev.usage?.total_tokens ?? 0\n  }\n}];"
      },
      "id": "7204e88a-51f3-4937-abbe-84a039da8837",
      "name": "Merge Final Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1344, 608]
    },
