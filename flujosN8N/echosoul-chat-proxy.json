    },
    {
      "parameters": {
        "url": "=https://pleeiqlldiwipaxqoumu.supabase.co/rest/v1/messages?session_id=eq.{{ $('Webhook Chat').first().json.body.session_id }}&order=created_at.desc&limit=8",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{$env.SUPABASE_SERVICE_KEY}}" },
            { "name": "Authorization", "value": "=Bearer {{$env.SUPABASE_SERVICE_KEY}}" },
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "options": {}
      },
      "id": "68a2b38d-8039-4f2d-b2e6-e34577e944f3",
      "name": "Fetch Recent Messages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [560, 608],
      "alwaysOutputData": true,
      "credentials": { "httpHeaderAuth": { "id": "OJfBPZ3oav1nvDyb", "name": "EchoSoul-supabase" } },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const webhook = $('Webhook Chat').first().json.body;\n\nconst memoriesRaw = $('Fetch Memories').all();\nconst memories = memoriesRaw.map(i => i.json);\n\nconst msgsRaw = $('Fetch Recent Messages').all();\nconst msgs = msgsRaw\n  .map(i => i.json)\n  .filter(m => m && m.role && m.content); // Ignorar items vacíos cuando no hay historial\n\nconst memoriesText = memories.length\n  ? memories.map(m => `- [${m.category ?? 'general'}] ${m.content}`).join('\\n')\n  : '(sin memorias previas registradas)';\n\nconst systemPrompt = `Eres EchoSoul, una compañía empática e inteligente.\nTu objetivo es ser una presencia positiva y de apoyo para el usuario.\n\nLo que recuerdas de este usuario:\n${memoriesText}\n\nDirectrices:\n- Responde siempre en el idioma del usuario.\n- Sé empático, cálido y auténtico.\n- Mantén respuestas concisas.\n- Nunca des consejos médicos ni jurídicos específicos.`;\n\nconst messages = [\n  {\n    role: 'system',\n    content: systemPrompt\n  },\n  ...msgs.reverse().map(m => ({\n    role: m.role,\n    content: m.content\n  })),\n  {\n    role: 'user',\n    content: webhook.message\n  }\n];\n\nreturn [{\n  json: {\n    user_id: webhook.user_id,\n    session_id: webhook.session_id,\n    message: webhook.message,\n    messages\n  }\n}];"
      },
      "id": "4bedb44a-49c5-47a7-8c8c-a60d08f33064",
      "name": "Build System Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [768, 608]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
