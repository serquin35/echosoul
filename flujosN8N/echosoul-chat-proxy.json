    },
    {
      "parameters": {
        "url": "=https://pleeiqlldiwipaxqoumu.supabase.co/rest/v1/messages?user_id=eq.{{ $json.body.user_id }}&created_at=gte.{{ new Date(Date.now()-86400000).toISOString() }}&select=count",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{$env.SUPABASE_SERVICE_KEY}}" },
            { "name": "Authorization", "value": "=Bearer {{$env.SUPABASE_SERVICE_KEY}}" },
            { "name": "Prefer", "value": "count=exact" },
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "options": {}
      },
      "id": "f31198f6-aa1e-4f53-b8d7-48f610b81571",
      "name": "Check Usage Limits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [-192, 592],
      "credentials": { "httpHeaderAuth": { "id": "OJfBPZ3oav1nvDyb", "name": "EchoSoul-supabase" } },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst messageCount = items.length;\n\nconst webhookData = $('Webhook Chat').first().json.body;\nconst planLimit = webhookData.plan_limit ?? 20;\n\nreturn [{\n  json: {\n    ...webhookData,\n    message_count: messageCount,\n    plan_limit: planLimit,\n    limit_reached: messageCount >= planLimit\n  }\n}];"
      },
      "id": "d52fd7ad-1236-443e-b295-a818b983ba0e",
      "name": "Parse Usage Count",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-16, 592]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
          "conditions": [
            {
              "id": "cond_1",
              "leftValue": "={{ $json.limit_reached }}",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ec9957f1-84b8-4e08-aa40-398592505818",
