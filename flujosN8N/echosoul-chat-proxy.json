      "id": "af3d8019-52b3-4af3-9d6c-89d1fe45804c",
      "name": "Fetch Memories",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [368, 608],
      "alwaysOutputData": true,
      "credentials": { "httpHeaderAuth": { "id": "OJfBPZ3oav1nvDyb", "name": "EchoSoul-supabase" } },
