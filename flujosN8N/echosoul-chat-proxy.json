      "parameters": {
        "url": "=https://pleeiqlldiwipaxqoumu.supabase.co/rest/v1/messages?user_id=eq.{{ $json.body.user_id }}&created_at=gte.{{ new Date(Date.now()-86400000).toISOString() }}&select=count",
