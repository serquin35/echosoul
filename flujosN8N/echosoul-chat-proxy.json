    {
      "parameters": {
        "jsCode": "try {\n  const items = $input.all();\n  const messageCount = items.length;\n\n  const webhookData = $(\"Webhook Chat\").first().json.body;\n  const planLimit = webhookData.plan_limit ?? 20;\n\n  // Sanitización de user_id para evitar errores de tipo UUID en Supabase\n  const rawUserId = webhookData.user_id || '';\n  const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n  const sanitizedUserId = uuidRegex.test(rawUserId) \n    ? rawUserId \n    : '00000000-0000-0000-0000-000000000000';\n\n  return [{\n    json: {\n      ...webhookData,\n      user_id: sanitizedUserId,\n      message_count: messageCount,\n      plan_limit: planLimit,\n      limit_reached: messageCount >= planLimit\n    }\n  }];\n} catch (error) {\n  return [{\n    json: {\n      error: error.message,\n      limit_reached: false\n    }\n  }];\n}"
      },
