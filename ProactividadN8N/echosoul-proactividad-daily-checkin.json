            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({to:$json.fcm_token,notification:{title:'EchoSoul 💙',body:$json.generated_message},data:{type:'daily_checkin'}}) }}",
        "options": {}
      }
    },
    {
      "id": "0c539df5-a69f-4ac5-a77f-7f1b3dcc2e30",
      "name": "Send email checkin",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        800,
        2700
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.email }}",
        "subject": "=EchoSoul está aquí contigo hoy 💙",
        "emailType": "html",
        "message": "={{ '<div style=\"font-family:sans-serif;padding:24px;max-width:480px\">' + $json.generated_message + '</div>' }}",
        "options": {}
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    },
