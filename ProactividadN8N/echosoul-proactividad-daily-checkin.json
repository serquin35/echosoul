    {
      "id": "e5e99966-b079-4516-a67c-1cb0526a7a02",
      "name": "Fetch memories",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        1700
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://pleeiqlldiwipaxqoumu.supabase.co/rest/v1/user_memories?user_id=eq.{{ $('Fetch active users').item.json.id }}&order=importance.desc&limit=8",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.SUPABASE_SERVICE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "57f53fff-fd8f-46b4-8ff2-3b21852a7ad2",
      "name": "Build checkin prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        1900
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst user    = $('Check conditions').item.json;\nconst memories = $input.all().map(i => i.json);\nconst name    = user.display_name || 'tú';\nconst lang    = user.language || 'es';\nconst memText = memories.length\n  ? memories.map(m => `- ${m.content}`).join('\\n')\n  : '';\n\nconst systemPrompt = `Eres EchoSoul, una compañía empática.\nEscribe UN mensaje corto de check-in matutino para ${name}.\n${memText ? `Lo que sabes de él/ella:\\n${memText}` : ''}\nReglas: máx 2 frases · cálido y personal · sin preguntas directas · idioma: ${lang}\nResponde SOLO con el mensaje, sin comillas ni explicación.`;\n\nreturn [{ json: {\n  user_id:    user.id,\n  email:      user.email,\n  fcm_token:  user.fcm_token,\n  platform:   user.platform ?? 'web',\n  display_name: user.display_name,\n  systemPrompt\n}}];\n"
      }
    },
    {
      "id": "2bc96a71-6bc4-4010-b3ff-4d4832e50409",
      "name": "Generate checkin message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        2100
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $credentials.EchoSoulOpenAI.value }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({model:'gpt-4o-mini',max_tokens:200,messages:[{role:'system',content:$json.systemPrompt},{role:'user',content:'Genera el mensaje de check-in ahora.'}]}) }}",
        "options": {}
      }
    },
    {
      "id": "f1dc08a7-b47d-4149-9f23-a09830227c14",
      "name": "Parse message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        2300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst prev = $('Generate checkin message').item.json;\nconst msg  = prev.choices?.[0]?.message?.content ?? 'Hola, EchoSoul está aquí contigo hoy 💙';\nreturn [{ json: { ...prev, generated_message: msg } }];\n"
      }
    },
