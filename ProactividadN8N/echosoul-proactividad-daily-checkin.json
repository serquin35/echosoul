          "conditions": [
            {
              "id": "59f20e79-c137-4a84-9f4c-06258d671836",
              "leftValue": "={{ $json.skip }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
