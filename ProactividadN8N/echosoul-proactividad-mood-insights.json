      "parameters": {
        "method": "GET",
        "url": "=https://pleeiqlldiwipaxqoumu.supabase.co/rest/v1/user_memories?user_id=eq.{{ $('Analyze mood pattern').first().json.user_id }}&order=importance.desc&limit=8",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "{{ $credentials.EchoSoulSupabase.value }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $credentials.EchoSoulSupabase.value }}"
