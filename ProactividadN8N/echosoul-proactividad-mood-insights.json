    {
      "id": "7691c7b1-7b8f-4a30-b578-00b63fdd4f14",
      "name": "Fetch mood history",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://pleeiqlldiwipaxqoumu.supabase.co/rest/v1/mood_entries?user_id=eq.{{ $json.body.user_id }}&order=created_at.desc&limit=7",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "{{ $credentials.EchoSoulSupabase.value }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $credentials.EchoSoulSupabase.value }}"
            },
