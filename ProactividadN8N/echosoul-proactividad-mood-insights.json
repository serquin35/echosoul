    {
      "id": "fe2f343a-39a5-4067-9103-72a57d648621",
      "name": "Build insight prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        1300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst analysis = $('Analyze mood pattern').item.json;\nconst profile  = $('Fetch profile for insight').item.json;\nconst memories = $input.all().map(i => i.json);\n\nconst name    = profile.display_name || 'tú';\nconst lang    = profile.language || 'es';\nconst memText = memories.length ? memories.map(m => `- ${m.content}`).join('\\n') : '';\n\nconst severityPrompt = analysis.severity === 'high'\n  ? 'El usuario puede estar pasando por un momento muy difícil. Sé muy empático, menciona que no está solo/a y que puede hablar contigo cuando quiera.'\n  : 'El usuario lleva varios días con el ánimo bajo. Muéstrate presente y cálido, sin dramatizar.';\n\nconst systemPrompt = `Eres EchoSoul. ${severityPrompt}\n${memText ? `Lo que sabes de ${name}:\\n${memText}` : ''}\nEscribe UN mensaje empático de apoyo. Máx 3 frases. Idioma: ${lang}.\nNO diagnostiques. NO des consejos de salud mental.\nResponde SOLO con el mensaje.`;\n\nreturn [{ json: {\n  user_id:    analysis.user_id,\n  email:      profile.email,\n  fcm_token:  profile.fcm_token,\n  platform:   profile.platform ?? 'web',\n  severity:   analysis.severity,\n  systemPrompt\n}}];\n"
      }
    },
    {
      "id": "ab931caf-2ad7-4c33-a1e2-4b2f177eba51",
      "name": "Generate insight message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        1500
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $credentials.EchoSoulOpenAI.value }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({model:'gpt-4o-mini',max_tokens:300,messages:[{role:'system',content:$json.systemPrompt},{role:'user',content:'Genera el mensaje de apoyo ahora.'}]}) }}",
        "options": {}
      }
    },
    {
      "id": "7f6320a4-8052-4e59-a254-11c9e64d2cbe",
      "name": "Parse insight",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        1700
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst prev    = $('Generate insight message').item.json;\nconst llm_msg = prev.choices?.[0]?.message?.content ?? 'EchoSoul está aquí contigo 💙';\nreturn [{ json: { ...prev, generated_message: llm_msg } }];\n"
      }
    },
