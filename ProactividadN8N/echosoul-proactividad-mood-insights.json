    {
      "id": "31cfb989-852d-498d-a88d-2f285751685c",
      "name": "Analyze mood pattern",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        500
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst entries = $input.all().map(i => i.json);\nconst userId  = $('Webhook mood entry').first().json.body.user_id;\n\nif (entries.length < 3) {\n  return [{ json: { user_id: userId, needsInsight: false, reason: 'not_enough_data' } }];\n}\n\nconst scores = entries.map(e => e.mood_score).filter(s => s != null);\nconst avg    = scores.reduce((a, b) => a + b, 0) / scores.length;\n\n// Detecta racha baja: 3+ entradas consecutivas ≤ 3 (asume escala 1-10)\nconst lastThree    = scores.slice(0, 3);\nconst allLow       = lastThree.every(s => s <= 3);\nconst downwardTrend = scores.length >= 4 &&\n  scores[0] < scores[1] && scores[1] < scores[2] && scores[2] < scores[3];\n\nlet severity = 'none';\nif (allLow && avg <= 2)          severity = 'high';\nelse if (allLow || downwardTrend) severity = 'medium';\nelse if (avg <= 3.5)              severity = 'low';\n\nreturn [{ json: {\n  user_id:      userId,\n  needsInsight: severity !== 'none',\n  severity,\n  avg_score:    Math.round(avg * 10) / 10,\n  entries_count: scores.length\n}}];\n"
      }
    },
    {
      "id": "3a0cc6da-ec48-444a-a01e-6d06a03fdea7",
      "name": "IF needs insight",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        500,
        700
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "f81198a6-8e9f-4f79-92a9-8a58c81d742b",
              "leftValue": "={{ $json.needsInsight }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "7c787eb5-88f8-4743-9740-fecf53a48fe5",
