    {
      "id": "25a25b2d-fe30-4ad3-a7dc-af25094fe3a1",
      "name": "Fetch recent checkins",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        500
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://pleeiqlldiwipaxqoumu.supabase.co/rest/v1/checkins?created_at=gte.{{ new Date(Date.now()-172800000).toISOString() }}&select=user_id&limit=1000",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_KEY}}"
            },
            {
