      ],
      "parameters": {
        "method": "GET",
        "url": "https://pleeiqlldiwipaxqoumu.supabase.co/rest/v1/profiles?onboarding_completed=eq.true&select=id,display_name,email,language,timezone,platform,fcm_token",
        "authentication": "none",
        "sendHeaders": true,
