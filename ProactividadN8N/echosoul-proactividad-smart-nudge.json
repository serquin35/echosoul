              "value": "application/json"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "75eb1e22-1222-41fd-841c-1482dcc6874f",
      "name": "Fetch recently active",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        700
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://pleeiqlldiwipaxqoumu.supabase.co/rest/v1/messages?created_at=gte.{{ new Date(Date.now()-86400000).toISOString() }}&select=user_id&limit=1000",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.SUPABASE_SERVICE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "293a2455-44fc-4323-a7a9-97d8aab2d685",
      "name": "Filter inactive users",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        900
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst allUsers      = $('Fetch all users').all().map(i => i.json);\nconst recentCheckins = $('Fetch recent checkins').all().map(i => i.json);\nconst recentActive   = $('Fetch recently active').all().map(i => i.json);\n\nconst checkinUserIds = new Set(recentCheckins.map(c => c.user_id).filter(Boolean));\nconst activeUserIds  = new Set(recentActive.map(m => m.user_id).filter(Boolean));\n\nconst inactive = allUsers.filter(u =>\n  u.id &&\n  !checkinUserIds.has(u.id) &&\n  !activeUserIds.has(u.id)\n);\n\nif (inactive.length === 0) return [];\n\n// Máx 50 nudges por ciclo\nreturn inactive.slice(0, 50).map(u => ({ json: u }));\n"
      }
    },
    {
      "id": "14722007-79c3-4049-aa18-ce1306d24df4",
      "name": "IF has inactive",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        500,
        1100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "8ece533b-5af4-46c4-9bf7-e6300711d022",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "84eb068c-cb80-41f2-83c4-bece874d42f8",
      "name": "No inactive users",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        200,
        1300
      ],
      "parameters": {}
    },
    {
      "id": "883c8686-ec3b-44b0-ae6a-4478bff6bbd7",
      "name": "Loop inactive",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        500,
        1300
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "35ea84fe-ac1f-4ee1-af74-5e644b047b55",
      "name": "Fetch nudge context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        1500
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://pleeiqlldiwipaxqoumu.supabase.co/rest/v1/user_memories?user_id=eq.{{ $json.id }}&order=importance.desc&limit=8",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.SUPABASE_SERVICE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "23f3d8ef-c113-4aca-83f9-d8c5226d7ac9",
      "name": "Build nudge prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        1700
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst user    = $('Fetch nudge context').item.json;\nconst memories = $input.all().map(i => i.json);\nconst name    = user.display_name || 'tú';\nconst lang    = user.language || 'es';\nconst memText = memories.length ? memories.map(m => `- ${m.content}`).join('\\n') : '';\n\nconst systemPrompt = `Eres EchoSoul. Escribe un mensaje suave para ${name} que lleva un tiempo sin conectar.\n${memText ? `Contexto:\\n${memText}` : ''}\nReglas: máx 1-2 frases · sin presión · sin \"¿por qué no has vuelto?\" · cálido · idioma: ${lang}\nResponde SOLO con el mensaje.`;\n\nreturn [{ json: {\n  user_id:    user.id,\n  email:      user.email,\n  fcm_token:  user.fcm_token,\n  platform:   user.platform ?? 'web',\n  display_name: user.display_name,\n  systemPrompt\n}}];\n"
      }
    },
    {
      "id": "5f6ee88a-1411-4b92-9623-221a90b0245c",
      "name": "Generate nudge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        1900
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $credentials.EchoSoulOpenAI.value }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({model:'gpt-4o-mini',max_tokens:150,messages:[{role:'system',content:$json.systemPrompt},{role:'user',content:'Genera el mensaje ahora.'}]}) }}",
        "options": {}
      }
    },
    {
      "id": "7a003ba5-9d10-40ca-8783-df7367a354d2",
      "name": "Parse nudge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        2100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p=$input.first().json; const m=p.choices?.[0]?.message?.content??'EchoSoul te echa de menos 💙'; return [{json:{...p,generated_message:m}}];"
      }
    },
    {
      "id": "7e6f472b-8161-4682-9e35-12a4ba58d493",
      "name": "IF android nudge",
      "type": "n8n-nodes-base.if",
