{
  "name": "EchoSoul — proactividad: smart-nudge",
  "nodes": [
    {
      "id": "15af12a5-98ee-4ad1-b86a-09cefb2b4934",
      "name": "Cron every 6h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        500,
        100
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */6 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "cbea294d-c20e-496f-899d-34c074050552",
      "name": "Fetch all users",
      "type": "n8n-nodes-base.httpRequest",
