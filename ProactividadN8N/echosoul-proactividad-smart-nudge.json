      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "864174cd-7cf4-441e-8eaa-b3d1c5e8a1e3",
              "leftValue": "={{ $json.platform }}",
              "rightValue": "android",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
