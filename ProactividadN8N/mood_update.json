{"id":"uWNPk5KWMgTbJtlc","name":"EchoSoul — proactividad: mood-insights","nodes":[{"parameters":{"httpMethod":"POST","path":"mood-entry","responseMode":"responseNode","options":{}},"id":"1ba9df40-98ea-468a-abf4-42da7deb0361","name":"Webhook mood entry","type":"n8n-nodes-base.webhook","typeVersion":1.1,"position":[-752,304],"webhookId":"0e7d7be6-eb09-41a7-8e2b-063c923a72d5"},{"parameters":{"url":"=https://pleeiqlldiwipaxqoumu.supabase.co/rest/v1/mood_entries?user_id=eq.{{ $json.body.user_id }}&order=created_at.desc&limit=7","sendHeaders":true,"headerParameters":{"parameters":[{"name":"apikey","value":"{{ $credentials.EchoSoul-supabase.value }}"},{"name":"Authorization","value":"Bearer {{ $credentials.EchoSoul-supabase.value }}"},{"name":"Content-Type","value":"application/json"}]},"options":{}},"id":"b47a1b28-b52b-4efb-9f71-f0bb6de2bf9f","name":"Fetch mood history","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[-544,304]},{"parameters":{"jsCode":"\nconst entries = $input.all().map(i => i.json);\nconst userId  = $('Webhook mood entry').first().json.body.user_id;\n\nif (entries.length < 3) {\n  return [{ json: { user_id: userId, needsInsight: false, reason: 'not_enough_data' } }];\n}\n\nconst scores = entries.map(e => e.mood_score).filter(s => s != null);\nconst avg    = scores.reduce((a, b) => a + b, 0) / scores.length;\n\n// Detecta racha baja: 3+ entradas consecutivas ≤ 3 (asume escala 1-10)\nconst lastThree    = scores.slice(0, 3);\nconst allLow       = lastThree.every(s => s <= 3);\nconst downwardTrend = scores.length >= 4 &&\n  scores[0] < scores[1] && scores[1] < scores[2] && scores[2] < scores[3];\n\nlet severity = 'none';\nif (allLow && avg <= 2)          severity = 'high';\nelse if (allLow || downwardTrend) severity = 'medium';\nelse if (avg <= 3.5)              severity = 'low';\n\nreturn [{ json: {\n  user_id:      userId,\n  needsInsight: severity !== 'none',\n  severity,\n  avg_score:    Math.round(avg * 10) / 10,\n  entries_count: scores.length\n}}];\n"},"id":"de5d62e1-4a8b-4186-9532-fd495add4066","name":"Analyze mood pattern","type":"n8n-nodes-base.code","typeVersion":2,"position":[-368,304]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":1},"conditions":[{"id":"f81198a6-8e9f-4f79-92a9-8a58c81d742b","leftValue":"={{ $json.needsInsight }}","rightValue":true,"operator":{"type":"boolean","operation":"true"}}],"combinator":"and"},"options":{}},"id":"a870cb59-a422-44aa-b4a3-45ed78d4e038","name":"IF needs insight","type":"n8n-nodes-base.if","typeVersion":2,"position":[-192,304]},{"parameters":{"respondWith":"json","responseBody":"={\"insight_sent\":false,\"reason\":\"no_pattern\"}","options":{"responseCode":200}},"id":"e79b9c9c-1941-432d-8f7b-d8684ec00599","name":"Respond no insight","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.1,"position":[0,464]},{"parameters":{"url":"=https://pleeiqlldiwipaxqoumu.supabase.co/rest/v1/profiles?id=eq.{{ $json.user_id }}&select=id,display_name,email,language,platform,fcm_token&limit=1","sendHeaders":true,"headerParameters":{"parameters":[{"name":"apikey","value":"{{ $credentials.EchoSoul-supabase.value }}"},{"name":"Authorization","value":"Bearer {{ $credentials.EchoSoul-supabase.value }}"},{"name":"Content-Type","value":"application/json"}]},"options":{}},"id":"6bfbcc55-732c-4d13-8f61-ca752f79ba2b","name":"Fetch profile for insight","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[0,288]},{"parameters":{"url":"=https://pleeiqlldiwipaxqoumu.supabase.co/rest/v1/user_memories?user_id=eq.{{ $('Analyze mood pattern').first().json.user_id }}&order=importance.desc&limit=8","sendHeaders":true,"headerParameters":{"parameters":[{"name":"apikey","value":"{{ $credentials.EchoSoul-supabase.value }}"},{"name":"Authorization","value":"Bearer {{ $credentials.EchoSoul-supabase.value }}"},{"name":"Content-Type","value":"application/json"}]},"options":{}},"id":"fdf604ec-6970-4dc5-af23-eb42c6066f0a","name":"Fetch memories for insight","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[176,288]},{"parameters":{"jsCode":"\nconst analysis = $('Analyze mood pattern').item.json;\nconst profile  = $('Fetch profile for insight').item.json;\nconst memories = $input.all().map(i => i.json);\n\nconst name    = profile.display_name || 'tú';\nconst lang    = profile.language || 'es';\nconst memText = memories.length ? memories.map(m => `- ${m.content}`).join('\\n') : '';\n\nconst severityPrompt = analysis.severity === 'high'\n  ? 'El usuario puede estar pasando por un momento muy difícil. Sé muy empático, menciona que no está solo/a y que puede hablar contigo cuando quiera.'\n  : 'El usuario lleva varios días con el ánimo bajo. Muéstrate presente y cálido, sin dramatizar.';\n\nconst systemPrompt = `Eres EchoSoul. ${severityPrompt}\n${memText ? `Lo que sabes de ${name}:\\n${memText}` : ''}\nEscribe UN mensaje empático de apoyo. Máx 3 frases. Idioma: ${lang}.\nNO diagnostiques. NO des consejos de salud mental.\nResponde SOLO con el mensaje.`;\n\nreturn [{ json: {\n  user_id:    analysis.user_id,\n  email:      profile.email,\n  fcm_token:  profile.fcm_token,\n  platform:   profile.platform ?? 'web',\n  severity:   analysis.severity,\n  systemPrompt\n}}];\n"},"id":"35654c1b-5284-4d6c-96e1-c08beaeb292a","name":"Build insight prompt","type":"n8n-nodes-base.code","typeVersion":2,"position":[336,288]},{"parameters":{"method":"POST","url":"https://api.openai.com/v1/chat/completions","sendHeaders":true,"headerParameters":{"parameters":[]},"sendBody":true,"contentType":"raw","rawContentType":"application/json","body":"={{ JSON.stringify({model:'gpt-4o-mini',messages:[{role:'system',content:$json.systemPrompt},{role:'user',content:'Genera el mensaje de apoyo ahora.'}]}) }}","options":{},"authentication":"predefinedCredentialType","nodeCredentialType":"openAiApi"},"id":"31112fe0-2b37-4353-9482-893a1582a861","name":"Generate insight message","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[512,288],"credentials":{"openAiApi":{"id":"KzFxOuQEjV23LyRC","name":"OpenAi account"}}},{"parameters":{"jsCode":"\nconst prev    = $('Generate insight message').item.json;\nconst llm_msg = prev.choices?.[0]?.message?.content ?? 'EchoSoul está aquí contigo 💙';\nreturn [{ json: { ...prev, generated_message: llm_msg } }];\n"},"id":"17941917-038e-48d3-8864-3391f22c1d05","name":"Parse insight","type":"n8n-nodes-base.code","typeVersion":2,"position":[656,288]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":1},"conditions":[{"id":"40c257f3-d96d-4169-9f0c-0a95b70c487b","leftValue":"={{ $json.platform }}","rightValue":"android","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"options":{}},"id":"5986e328-9b3f-46f4-b389-4a9b9509ccf7","name":"IF android mood","type":"n8n-nodes-base.if","typeVersion":2,"position":[832,288]},{"parameters":{"method":"POST","url":"https://fcm.googleapis.com/v1/projects/echosoul-one/messages:send","sendHeaders":true,"headerParameters":{"parameters":[]},"sendBody":true,"contentType":"raw","rawContentType":"application/json","body":"={{ JSON.stringify({message:{token:$json.fcm_token,notification:{title:'EchoSoul 💙',body:$json.generated_message},data:{type:'mood_insight'}}}) }}","options":{},"authentication":"predefinedCredentialType","nodeCredentialType":"googleApi"},"id":"17c3daa6-9d50-40b4-9d11-0fb216c7497c","name":"Send FCM insight","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1008,192],"credentials":{"googleApi":{"id":"0o4FmPorago01fiu","name":"Firebase EchoSoul Admin"}}},{"parameters":{"sendTo":"={{ $json.email }}","subject":"=EchoSoul tiene algo para ti 💙","message":"={{ '<div style=\"font-family:sans-serif;padding:24px;max-width:480px\">' + $json.generated_message + '</div>' }}","options":{}},"id":"3df4343f-f2f8-4e4b-97c3-47a4dee67a6c","name":"Send email insight","type":"n8n-nodes-base.gmail","typ