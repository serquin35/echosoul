      "id": "34a515ca-f9df-4986-bd97-962ae7d12406",
      "name": "Fetch today checkins",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        176,
        336
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst user   = $('Fetch active users').item.json;\nconst prefs  = $('Fetch user preferences').item.json ?? {};\nconst today_checkins = $input.all();   // output de Fetch today checkins\n\n// 1. proactivity_level = 0 → usuario no quiere contacto proactivo\nif ((prefs.proactivity_level ?? 3) === 0) {\n  return [{ json: { ...user, skip: true, reason: 'proactivity_disabled' } }];\n}\n\n// 2. Ya recibió contacto hoy → skip\nif (today_checkins.length > 0 && today_checkins[0].json && today_checkins[0].json.id) {\n  return [{ json: { ...user, skip: true, reason: 'already_contacted_today' } }];\n}\n\n// 3. Verificar safe_hours (hora local del usuario)\nconst tz       = user.timezone ?? 'Europe/Madrid';\nconst localHour = parseInt(\n  new Intl.DateTimeFormat('en', { timeZone: tz, hour: 'numeric', hour12: false }).format(new Date()), 10\n);\nconst safeStart = prefs.safe_hours_start ? parseInt(String(prefs.safe_hours_start).split(':')[0], 10) : 8;\nconst safeEnd   = prefs.safe_hours_end   ? parseInt(String(prefs.safe_hours_end).split(':')[0],   10) : 22;\n\nif (localHour < safeStart || localHour >= safeEnd) {\n  return [{ json: { ...user, skip: true, reason: 'outside_safe_hours' } }];\n}\n\nreturn [{ json: {\n  ...user,\n  skip:       false,\n  prefs:      prefs,\n  safeStart,\n  safeEnd\n}}];\n"
      },
