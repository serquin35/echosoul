    {
      "parameters": {
        "jsCode": "\nconst user    = $('Check conditions').item.json;\nconst memories = $input.all().map(i => i.json);\nconst name    = user.display_name || 'tú';\nconst lang    = user.language || 'es';\nconst memText = memories.length\n  ? memories.map(m => `- ${m.content}`).join('\\n')\n  : '';\n\nconst systemPrompt = `Eres EchoSoul, una compañía empática.\nEscribe UN mensaje corto de check-in matutino para ${name}.\n${memText ? `Lo que sabes de él/ella:\\n${memText}` : ''}\nReglas: máx 2 frases · cálido y personal · sin preguntas directas · idioma: ${lang}\nResponde SOLO con el mensaje, sin comillas ni explicación.`;\n\nreturn [{ json: {\n  user_id:    user.id,\n  email:      user.email,\n  fcm_token:  user.fcm_token,\n  platform:   user.platform ?? 'web',\n  display_name: user.display_name,\n  systemPrompt\n}}];\n"
      },
