{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "handle": "filesystem" },
    { "src": "/terms-en",   "dest": "/terms-en.html" },
    { "src": "/privacy-en", "dest": "/privacy-en.html" },
    { "src": "/cookies-en", "dest": "/cookies-en.html" },
    { "src": "/app/(.*)",   "dest": "/app/index.html" },
    { "src": "/en",           "dest": "/index-en.html" },
    { "src": "/((?!app/).*)", "dest": "/index.html" }
  ]
}
