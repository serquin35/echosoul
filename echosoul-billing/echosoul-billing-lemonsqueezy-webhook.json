        500,
        700
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst ev   = $json;\nconst data = ev.data;\nconst eventName = ev.event_name;\n\n// Mapa de status Lemon Squeezy \u2192 plan EchoSoul\nconst STATUS_MAP = {\n  active:   { plan: 'premium', daily_limit: 9999 },\n  on_trial: { plan: 'premium', daily_limit: 9999 },\n  past_due: { plan: 'premium', daily_limit: 9999 },  // grace period\n  unpaid:   { plan: 'free',    daily_limit: 20 },\n  cancelled:{ plan: 'free',    daily_limit: 20 },\n  expired:  { plan: 'free',    daily_limit: 20 },\n};\n\nconst subStatus = data.attributes?.status ?? 'expired';\nconst planInfo = STATUS_MAP[subStatus] ?? { plan: 'free', daily_limit: 20 };\n\nreturn [{ json: {\n  user_id:         ev.user_id,\n  provider:        'lemonsqueezy',\n  provider_sub_id: data.id ?? null,\n  status:          subStatus,\n  plan:            planInfo.plan,\n  daily_limit:     planInfo.daily_limit,\n  expires_at:      data.attributes?.renews_at ?? data.attributes?.ends_at ?? null,\n  plan_id:         data.attributes?.variant_id?.toString() ?? null,\n  event_type:      eventName,\n  raw_event:       $('Webhook Lemon Squeezy').first().json.body\n}}];\n"
      }
    },
