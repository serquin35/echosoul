      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst crypto = require('crypto');\n\nconst body    = $json.body;\nconst headers = $json.headers;\nconst sigHeader = headers['x-signature'] ?? '';\nconst secret = 'Echosoul2026Secret*';  // \u2190 reemplaza con tu secret real\n\nconst rawBody = typeof body === 'string' ? body : JSON.stringify(body);\nconst expected = crypto.createHmac('sha256', secret).update(rawBody).digest('hex');\n\nif (secret !== 'Echosoul2026Secret*' && expected !== sigHeader) {\n  return [{ json: { valid: false, reason: 'invalid_signature' } }];\n}\n\nconst eventName = body.meta?.event_name ?? '';\nconst data      = body.data ?? {};\n\n// user_id debe venir en custom_data del checkout de Lemon Squeezy\nconst userId = body.meta?.custom_data?.user_id ?? null;\n\nif (!userId) {\n  return [{ json: { valid: false, reason: 'no_user_id_in_custom_data', event_name: eventName } }];\n}\n\nreturn [{ json: { valid: true, event_name: eventName, data, user_id: userId } }];\n"
      }
    },
