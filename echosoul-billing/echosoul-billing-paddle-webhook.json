    {
      "id": "ecea0164-1afa-4346-bd28-d70a4aacd4ab",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst crypto = require('crypto');\n\nconst body    = $json.body;\nconst headers = $json.headers;\nconst sigHeader = headers['paddle-signature'] ?? '';\n\n// Paddle Billing v2 signature: \"ts=TIMESTAMP;h1=HMAC_SHA256\"\nconst parts = {};\nsigHeader.split(';').forEach(p => {\n  const idx = p.indexOf('=');\n  if (idx > -1) parts[p.substring(0, idx)] = p.substring(idx + 1);\n});\n\nconst ts = parts['ts'] ?? '';\nconst h1 = parts['h1'] ?? '';\nconst secret = 'PADDLE_WEBHOOK_SECRET';  // ← reemplaza con tu secret real\n\n// Reconstruye el payload firmado\nconst rawBody = JSON.stringify(body);\nconst signed  = `${ts}:${rawBody}`;\nconst expected = crypto.createHmac('sha256', secret).update(signed).digest('hex');\n\nif (secret !== 'PADDLE_WEBHOOK_SECRET' && expected !== h1) {\n  return [{ json: { valid: false, reason: 'invalid_signature' } }];\n}\n\nconst eventType = body.event_type ?? '';\nconst data      = body.data ?? {};\n\n// user_id debe venir en custom_data del checkout de Paddle\nconst userId = data?.custom_data?.user_id\n            ?? data?.customer?.custom_data?.user_id\n            ?? null;\n\nif (!userId) {\n  return [{ json: { valid: false, reason: 'no_user_id_in_custom_data', event_type: eventType } }];\n}\n\nreturn [{ json: { valid: true, event_type: eventType, data, user_id: userId } }];\n"
      }
    },
    {
      "id": "64a2d838-411a-48d7-b557-a8c30d90fd46",
      "name": "IF valid",
      "type": "n8n-nodes-base.if",
