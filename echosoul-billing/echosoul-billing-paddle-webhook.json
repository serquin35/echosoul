      "position": [
        500,
        500
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "ad9835f7-a06f-4c4d-b3cf-b514f4811a26",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "dc56ae2b-a453-4ef4-8518-4ab14115c186",
      "name": "Respond 401",
      "type": "n8n-nodes-base.respondToWebhook",
