    {
      "id": "d115076a-81e9-4244-8bec-18674bb882e6",
      "name": "Parse event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        700
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst ev   = $json;\nconst data = ev.data;\nconst eventType = ev.event_type;\n\n// Mapa de status Paddle → plan EchoSoul\nconst STATUS_MAP = {\n  active:   { plan: 'premium', daily_limit: 999 },\n  trialing: { plan: 'premium', daily_limit: 999 },\n  past_due: { plan: 'premium', daily_limit: 999 },  // grace period\n  paused:   { plan: 'free',    daily_limit: 20 },\n  canceled: { plan: 'free',    daily_limit: 20 },\n};\n\n// Para eventos de transacción\nlet subStatus = data.status ?? 'canceled';\nif (eventType === 'transaction.payment_failed') subStatus = 'past_due';\nif (eventType === 'transaction.completed')      subStatus = 'active';\n\nconst planInfo = STATUS_MAP[subStatus] ?? { plan: 'free', daily_limit: 20 };\n\nreturn [{ json: {\n  user_id:         ev.user_id,\n  provider:        'paddle',\n  provider_sub_id: data.id ?? null,\n  status:          subStatus,\n  plan:            planInfo.plan,\n  daily_limit:     planInfo.daily_limit,\n  expires_at:      data.next_billed_at ?? data.current_billing_period?.ends_at ?? null,\n  plan_id:         data.items?.[0]?.price?.id ?? null,\n  event_type:      eventType,\n  raw_event:       $('Webhook Paddle').first().json.body\n}}];\n"
      }
    },
