{
  "name": "EchoSoul — memory-extractor",
  "nodes": [
    {
      "id": "41c74b8b-6370-4595-a47c-8e176d28f494",
      "name": "Webhook Extract Memory",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        500,
        100
      ],
      "parameters": {
        "path": "extract-memory",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "cb1699c4-bee6-4a84-882c-bbd8b2af7a40",
      "name": "Respond 200 Immediately",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        500,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"status\":\"received\"}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "6afd5d0e-b26c-46a9-9a2e-0a505901e345",
      "name": "Extract Memories LLM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        500
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $vars.CLAUDE_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({model:'claude-haiku-4-5-20251001',max_tokens:500,messages:[{role:'user',content:`Analiza este intercambio y extrae SOLO información factual importante sobre el usuario que valga la pena recordar a largo plazo.\\n\\nEXTRAER: nombre, edad, relaciones importantes, gustos duraderos, eventos de vida significativos, miedos, metas, trabajo/estudios.\\n\\nNO EXTRAER: estados de ánimo temporales, tema del chat de hoy, información genérica.\\n\\nSi no hay nada relevante, responde exactamente: []\\n\\nResponde ÚNICAMENTE con JSON válido, sin markdown, sin explicación:\\n[{\\\"content\\\": \\\"...\\\", \\\"importance\\\": 1-5, \\\"category\\\": \\\"personal|preference|event|relationship\\\"}]\\n\\nIntercambio a analizar:\\nUsuario: {{ $json.message }}\\nEchoSoul: {{ $json.reply }}`}]}) }}",
        "options": {}
      }
    },
    {
      "id": "35063e32-70fc-4b16-8c35-e3f474a52296",
      "name": "Parse Memories",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        700
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\n// El LLM debe devolver sólo JSON válido: [{content, importance, category}]\n// Si no hay nada, devuelve []\nconst llmText = $input.first().json.content?.[0]?.text ?? '[]';\n\nlet memories = [];\ntry {\n  // Limpia posibles backticks de markdown que el LLM añada\n  const clean = llmText.replace(/```json|```/gi, '').trim();\n  memories = JSON.parse(clean);\n  if (!Array.isArray(memories)) memories = [];\n} catch(e) {\n  // Si el parse falla, no hay memorias que guardar\n  memories = [];\n}\n\n// Filtrar: solo importancia >= 2, contenido válido\nconst filtered = memories\n  .filter(m => m && m.content && (m.importance ?? 0) >= 2)\n  .map(m => ({\n    content:      String(m.content).substring(0, 200).trim(),\n    importance:   Math.min(5, Math.max(1, parseInt(m.importance, 10) || 2)),\n    category:     ['personal','preference','event','relationship'].includes(m.category)\n                  ? m.category : 'personal',\n    // Hash simple para deduplicación: user_id + primeras 50 chars del contenido\n    content_hash: $('Webhook Extract Memory').first().json.user_id\n                  + ':' + String(m.content).substring(0, 50).toLowerCase().replace(/\\s+/g,' ')\n  }));\n\n// Pasar user_id a todos los items\nconst userId = $('Webhook Extract Memory').first().json.user_id;\nreturn filtered.map(m => ({ json: { user_id: userId, ...m } }));\n"
      }
    },
    {
      "id": "fcf7112f-04da-44a3-9dd2-2baed1927910",
      "name": "IF Has Memories",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        500,
        900
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "98e92e94-16df-4d49-bbcd-3f53052eacf4",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "b9c83fc7-c91c-4451-acd8-6ee2ed06ff72",
      "name": "No Memories Found",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        200,
        1100
      ],
      "parameters": {}
    },
    {
      "id": "05066b5a-0c47-4074-bdb3-bac5a7a5ac32",
