              "id": "subject",
              "name": "subject",
              "type": "string",
              "value": "=Hola {{ $('Normalize Payload').first().json.display_name || 'tú' }}, EchoSoul ya está aquí 👋"
            },
            {
              "id": "body",
              "name": "body",
              "type": "string",
              "value": "=<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#f9fafb;font-family:sans-serif;\">\n  <tr>\n    <td align=\"center\" style=\"padding:40px 20px;\">\n      <div style=\"max-width:500px;background-color:#0f1115;border-radius:24px;padding:48px 32px;text-align:center;box-shadow:0 10px 30px rgba(0,0,0,0.1);\">\n        <div style=\"font-size:32px;margin-bottom:24px;\">✨</div>\n        <h2 style=\"color:#f4f4f5;font-size:22px;font-weight:600;margin:0 0 16px 0;\">\n          Hola {{ $('Normalize Payload').first().json.display_name || 'tú' }} 👋\n        </h2>\n        <p style=\"color:#e4e4e7;font-size:16px;line-height:1.6;margin:0 0 16px 0;\">\n          Bienvenido/a a <strong>EchoSoul</strong>. Soy tu compañía personal — estoy aquí para escucharte, acompañarte y recordar lo que importa.\n        </p>\n        <p style=\"color:#a1a1aa;font-size:15px;line-height:1.6;margin:0 0 24px 0;\">\n          Empieza con un simple <em>\"hola\"</em> y yo haré el resto.\n        </p>\n        <a href=\"https://echosoul.dev/chat\" style=\"display:inline-block;background-color:#4f46e5;color:#ffffff;padding:14px 28px;border-radius:30px;text-decoration:none;font-weight:600;font-size:14px;margin-top:16px;\">\n          Abrir EchoSoul →\n        </a>\n        <div style=\"margin-top:40px;color:#52525b;font-size:12px;line-height:1.6;\">\n          En los próximos días te enviaré consejos para sacarle el máximo partido.<br>\n          Estás recibiendo esto porque eres parte de EchoSoul.<br>\n          Siempre aquí para escucharte.\n        </div>\n      </div>\n    </td>\n  </tr>\n</table>\n"
            }
          ]
