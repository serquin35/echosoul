      ],
      "parameters": {
        "content": "## Cómo llamar este webhook\n```dart\nawait http.post(\n  Uri.parse('$n8nUrl/webhook/new-user'),\n  body: jsonEncode({\n    'user_id': user.id,\n    'email': user.email,\n    'display_name': name,\n    'platform': isWeb ? 'web' : 'android',\n    'fcm_token': await fcm.getToken(),\n  }),\n);\n```",
        "height": 260,
        "width": 360,
        "color": 5
      }
    }
