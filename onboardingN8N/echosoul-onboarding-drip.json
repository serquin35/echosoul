{
  "name": "EchoSoul — onboarding: drip sequence",
  "nodes": [
    {
      "id": "8eb7908f-1f82-4196-82ec-5c3f54130a1a",
      "name": "Cron diario 10:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        500,
        100
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "24380fd4-6a56-4f6a-aa4a-c50ae95adc14",
      "name": "Fetch due users",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/user_onboarding?completed=eq.false&next_step_at=lte.{{ new Date().toISOString() }}&select=user_id,step,platform&limit=500",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "4e487c79-2545-4cee-8b6a-d95ab509e5ee",
      "name": "IF Has users",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        500,
        500
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "e01e32b7-5b4b-4936-91c6-588676261977",
              "leftValue": "={{ Array.isArray($json) ? $json.length : ($input.all().length) }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "df00530e-730b-42c6-910f-affcd5f43f7c",
      "name": "No users due",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        200,
        700
      ],
      "parameters": {}
    },
    {
      "id": "520ab2ac-be33-43bd-b23f-75daa1cd16bc",
      "name": "Loop users",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        500,
        700
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "63dff4a8-c984-4c3e-98f3-7004a8664916",
      "name": "Fetch user details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        900
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/user_profiles?user_id=eq.{{ $json.user_id }}&select=display_name,email,fcm_token",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "50d5cc6d-13bc-476d-afb6-d9381a0c7db9",
      "name": "Build step content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        1100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\n// Los datos del loop vienen del item actual; user details del nodo anterior\nconst onb  = $('Fetch due users').item.json;\nconst prof = $input.first().json;\nconst name = prof.display_name || 'tú';\nconst appUrl = $env.APP_URL ?? 'https://echosoul.dev';\n\nconst STEPS = {\n  1: {\n    subject:    `¿Cómo fue tu primer día con EchoSoul? 💬`,\n    body:       `<div style=\"font-family:sans-serif;max-width:480px;margin:0 auto;padding:32px 24px\">\n  <h2 style=\"font-size:20px;font-weight:500;color:#1a1a1a\">Hola ${name} 💬</h2>\n  <p style=\"color:#555;line-height:1.7\">\n    Ayer fue tu primer día con EchoSoul. ¿Ya tuviste tu primera conversación?\n  </p>\n  <p style=\"color:#555;line-height:1.7\">\n    Estoy aquí cuando lo necesites, sin importar la hora ni el tema.\n  </p>\n  <a href=\"${appUrl}/chat\"\n     style=\"display:inline-block;background:#534AB7;color:#fff;padding:12px 24px;\n            border-radius:8px;text-decoration:none;font-weight:500\">\n    Ir al chat →\n  </a>\n</div>`,\n    push_title: '¿Cómo fue ayer? 💬',\n    push_body:  'EchoSoul quiere saber cómo estás hoy.',\n    delay_h:    48\n  },\n  2: {\n    subject:    `Conoce el Mood Tracker 🌡️`,\n    body:       `<div style=\"font-family:sans-serif;max-width:480px;margin:0 auto;padding:32px 24px\">\n  <h2 style=\"font-size:20px;font-weight:500;color:#1a1a1a\">Registra cómo te sientes 🌡️</h2>\n  <p style=\"color:#555;line-height:1.7\">\n    Hola ${name}, ¿sabías que EchoSoul tiene un Mood Tracker?\n  </p>\n  <p style=\"color:#555;line-height:1.7\">\n    Cada día puedes registrar tu estado de ánimo. Con el tiempo\n    descubres patrones que te ayudan a entenderte mejor.\n  </p>\n  <a href=\"${appUrl}/mood\"\n     style=\"display:inline-block;background:#0F6E56;color:#fff;padding:12px 24px;\n            border-radius:8px;text-decoration:none;font-weight:500\">\n    Probar el Mood Tracker →\n  </a>\n</div>`,\n    push_title: 'Nueva función: Mood Tracker 🌡️',\n    push_body:  'Registra cómo te sientes hoy y descubre tus patrones.',\n    delay_h:    48\n  },\n  3: {\n    subject:    `Todo lo que EchoSoul puede hacer por ti ✨`,\n    body:       `<div style=\"font-family:sans-serif;max-width:480px;margin:0 auto;padding:32px 24px\">\n  <h2 style=\"font-size:20px;font-weight:500;color:#1a1a1a\">Llevamos días juntos ✨</h2>\n  <p style=\"color:#555;line-height:1.7\">\n    Hola ${name}, ya conoces EchoSoul. Con <strong>Premium</strong> puedes\n    llevar la experiencia mucho más lejos:\n  </p>\n  <ul style=\"color:#555;line-height:2;padding-left:20px\">\n    <li>📞 Llamadas de voz proactivas</li>\n    <li>🧠 Memoria avanzada y más profunda</li>\n    <li>♾️ Mensajes sin límite diario</li>\n  </ul>\n  <a href=\"${appUrl}/pricing\"\n     style=\"display:inline-block;background:#854F0B;color:#fff;padding:12px 24px;\n            border-radius:8px;text-decoration:none;font-weight:500\">\n    Ver planes Premium →\n  </a>\n  <p style=\"color:#aaa;font-size:12px;margin-top:32px\">\n    Sin compromiso. El plan Free sigue siendo gratuito para siempre.\n  </p>\n</div>`,\n    push_title: 'EchoSoul Premium ✨',\n    push_body:  'Desbloquea llamadas de voz, memoria avanzada y sin límites.',\n    delay_h:    null  // último paso → completed = true\n  }\n};\n\nconst s = STEPS[onb.step];\n\n// Paso fuera de rango → skip (no enviar, solo actualizar)\nif (!s) return [{ json: {\n  user_id: onb.user_id, email: prof.email,\n  fcm_token: prof.fcm_token, platform: onb.platform,\n  skip: true, next_step: onb.step + 1,\n  next_step_at: null, completed: true\n}}];\n\nconst nextStepAt = s.delay_h\n  ? new Date(Date.now() + s.delay_h * 3_600_000).toISOString()\n  : null;\n\nreturn [{ json: {\n  user_id:      onb.user_id,\n  email:        prof.email,\n  fcm_token:    prof.fcm_token,\n  platform:     onb.platform,\n  step:         onb.step,\n  skip:         false,\n  subject:      s.subject,\n  body:         s.body,\n  push_title:   s.push_title,\n  push_body:    s.push_body,\n  next_step:    onb.step + 1,\n  next_step_at: nextStepAt,\n  completed:    s.delay_h === null\n}}];\n"
      }
    },
    {
      "id": "f6543c30-f934-4d2b-a936-29af4402c45e",
      "name": "IF platform android",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        500,
        1300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "9e21c335-2c1e-4925-b578-a27c04ae31a9",
              "leftValue": "={{ $json.platform }}",
              "rightValue": "android",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "9b1613bd-8306-4920-ac6e-8b8f2d81769d",
      "name": "Send FCM push",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        200,
        1500
      ],
      "parameters": {
        "method": "POST",
        "url": "https://fcm.googleapis.com/fcm/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=key={{ $env.FCM_SERVER_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({to: $json.fcm_token,notification: {title: $json.push_title, body: $json.push_body},data: {type:'onboarding', step: String($json.step)}}) }}",
        "options": {}
      }
    },
    {
      "id": "1df12c2f-5657-4f41-9104-412fd5bf922e",
      "name": "Send drip email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        800,
        1500
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.email }}",
        "subject": "={{ $json.subject }}",
        "emailType": "html",
        "message": "={{ $json.body }}",
        "options": {}
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    },
    {
      "id": "364a3690-5cff-4ca0-8d31-6969df248435",
      "name": "Update onboarding step",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        1700
      ],
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/user_onboarding?user_id=eq.{{ $json.user_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({step:         $json.next_step,next_step_at: $json.next_step_at,completed:    $json.completed}) }}",
        "options": {}
      }
    },
    {
      "id": "04c2b50c-90e7-4568-8ac9-993e9ba56ef8",
      "name": "⏱️ State machine de pasos",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        860,
        700
      ],
      "parameters": {
        "content": "## Tabla user_onboarding\n| Campo | Valor inicial |\n|-------|---------------|\n| step | 1 |\n| next_step_at | now() + 24h |\n| completed | false |\n\nEl cron procesa solo usuarios donde\n`next_step_at <= now()` y `completed = false`.",
        "height": 240,
        "width": 340,
        "color": 3
      }
    }
  ],
